# Signzy API credentials (server-side only — never expose to the browser)
SIGNZY_API_KEY=your_signzy_authorization_key
SIGNZY_CLIENT_ID=your_client_email@example.com
SIGNZY_DEFAULT_ID=PAYTMSZY

# AES-256 response encryption (32-byte key as base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_ENCRYPTION_KEY=
NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=

# Optional: canonical site URL for origin checks
# APP_URL=https://your-site.netlify.app

# # Signzy API credentials (server-side only — never sent to the browser)
# SIGNZY_API_KEY=U2EB6T8r2cZ6EPUZxB9LfaunY1qZCNW2
# SIGNZY_CLIENT_ID=mohammed.taj@adsum.co.in
# SIGNZY_DEFAULT_ID=PAYTMSZY

# # AES-256 key (32 bytes, base64) — encrypts API responses
# # NEXT_PUBLIC_ is required so the website can decrypt in the browser
# PAYLOAD_ENCRYPTION_KEY=MO1aRrHEIwq+vXyAx2Ern/653H/TIoN3zulab897Reo=
# NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=MO1aRrHEIwq+vXyAx2Ern/653H/TIoN3zulab897Reo=
